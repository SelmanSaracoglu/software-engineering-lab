{
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/unit-testing-with-vitest",
    "test:unit:coverage": "vitest run src/unit-testing-with-vitest --coverage",
    "test:unit:closure": "npm run typecheck && npm run test:unit:coverage",
    "foundation-check": "node --import tsx src/typescript-for-testing/foundation-check/01-typed-api-data-and-test-helpers.ts",
    "test-foundations:01": "node --import tsx src/test-engineering-foundations/01-requirement-risk-and-test-language.ts",
    "test-foundations:02": "node --import tsx src/test-engineering-foundations/02-test-design-techniques.ts",
    "test-foundations:03": "node --import tsx src/test-engineering-foundations/03-test-levels-and-reliable-tests.ts",
    "test-foundations:check": "node --import tsx src/test-engineering-foundations/04-test-engineering-foundation-check.ts",
    "test-foundations": "npm run test-foundations:01 && npm run test-foundations:02 && npm run test-foundations:03 && npm run test-foundations:check"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^5.0.1",
    "cypress": "^15.21.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  }
}
